NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=
# Habilitar cada acesso somente após configurar e validar o provedor no Supabase.
# Segredos Google/Apple ficam no provedor Auth, nunca no navegador.
GOOGLE_AUTH_ENABLED=false
APPLE_AUTH_ENABLED=false
# Segredo somente do servidor, com pelo menos 32 caracteres aleatórios.
AUTH_RECOVERY_SECRET=
# Relatos: somente servidor. Usar remetente verificado no provedor SMTP.
SUPPORT_SMTP_HOST=
SUPPORT_SMTP_PORT=587
SUPPORT_SMTP_USER=
SUPPORT_SMTP_PASSWORD=
SUPPORT_MAIL_FROM=
