{
  "name": "nos-app",
  "version": "3.4.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --run dev:local --",
    "dev:local": "node --use-system-ca --use-env-proxy node_modules/next/dist/bin/next dev --hostname 127.0.0.1",
    "dev:supabase": "node scripts/local-supabase.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "test:db": "supabase test db --local",
    "test:calendar-locks": "node scripts/verify-calendar-locks-local.mjs",
    "test:authenticated": "node scripts/test-authenticated-local.mjs",
    "build": "next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/postcss": "^4.3.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@napi-rs/keyring": "2.1.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "2.118.0",
    "typescript": "^7.0.2"
  }
}
