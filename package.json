{
  "name": "nos-app",
  "version": "4.0.0-alpha.28",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "npm --prefix apps/web start",
    "dev:local": "npm run dev",
    "start": "npm run dev",
    "build": "npm --prefix apps/web run build",
    "typecheck": "npm --prefix apps/web run typecheck",
    "test": "npm run test:angular",
    "test:angular": "playwright test --config=playwright.angular.config.mjs",
    "test:authenticated": "playwright test --config=playwright.angular.config.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "test:db": "supabase test db --local",
    "test:calendar-locks": "node scripts/verify-calendar-locks-local.mjs",
    "test:account-notifications": "node --test scripts/test-account-notifications.mjs",
    "verify:support-mail": "node --use-system-ca --use-env-proxy --env-file-if-exists=.env.local scripts/verify-support-smtp.mjs",
    "test:integrations": "node --test scripts/test-angular-preview.mjs scripts/test-angular-support.mjs scripts/test-account-notifications.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/postcss": "^4.3.3",
    "nodemailer": "10.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@napi-rs/keyring": "2.1.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "supabase": "2.118.0"
  }
}
